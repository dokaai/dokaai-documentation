{
  "extends": ["config:recommended"],

  "baseBranchPatterns": ["dev"],

  "packageRules": [
    {
      "matchPackageNames": ["!dokaai-openapi-spec"],
      "enabled": false
    },

    {
      "matchPackageNames": ["dokaai-openapi-spec"],
      "rangeStrategy": "bump"
    },

    {
      "matchPackageNames": ["dokaai-openapi-spec"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },

    {
      "matchPackageNames": ["dokaai-openapi-spec"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    }
  ]
}